FROM node:22-bookworm-slim AS builder

# Update npm to fix dependencies (step-id: builder-update-npm)
RUN npm install -g npm@11.8.0

# install pnpm (step-id: builder-install-pnpm)
RUN npm install -g pnpm@10.33.0

# Copy package.json and package-lock.json first to leverage Docker layer caching (step-id: builder-copy-package)
COPY package*.json /app/

# Set working directory (step-id: builder-workdir)
WORKDIR /app

# build extensions (step-id: build-extension)
COPY extensions /app/extensions

# Ensure the extensions folder exists, even when no extension is built (step-id: ensure-extensions-folder)
RUN mkdir -p /app/extensions

FROM node:22-bookworm-slim

# Update npm to fix dependencies (step-id: update-npm)
RUN npm install -g npm@11.8.0

# Copy package.json and package-lock.json first to leverage Docker layer caching (step-id: copy-package)
COPY package*.json /app/

# Set working directory (step-id: workdir)
WORKDIR /app

# Install dependencies - without dev dependencies (step-id: install-deps)
RUN npm pkg delete devDependencies && rm package-lock.json && NODE_ENV=production npm install

# Cleaning benchmarks folder in tedious module for security (step-id: cleanup)
RUN rm -rf node_modules/tedious/benchmarks

# Copy the rest of the application code (step-id: copy-source)
COPY . .

# Copy the built extensions from the builder stage (step-id: copy-extensions)
COPY --from=builder /app/extensions ./extensions

# Start d9 server (step-id: start)
CMD ["npx","directus","start"]